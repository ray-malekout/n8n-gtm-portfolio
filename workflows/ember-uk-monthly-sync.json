    {
      "parameters": {
        "jsCode": "const rows = $('Get ember rows').all().map((i) => i.json);\nif (rows.length === 0) {\n  throw new Error('ember_uk_monthly returned no rows');\n}\nconst re = /^\\d{4}-\\d{2}$/;\nconst bad = rows.filter((r) => typeof r.month !== 'string' || !re.test(r.month));\nif (bad.length > 0) {\n  throw new Error(bad.length + ' rows have a missing or malformed month');\n}\nconst latest = rows.reduce((a, r) => (r.month > a ? r.month : a), rows[0].month);\n\nconst st = $('Get last published').all().map((i) => i.json);\nif (st.length !== 1) {\n  throw new Error('Expected exactly one last_published_month row in pipeline_state, found ' + st.length);\n}\nconst last = st[0].value;\nif (typeof last !== 'string' || !re.test(last)) {\n  throw new Error('last_published_month is missing or malformed: ' + JSON.stringify(last));\n}\n\nlet force = false;\nfor (const n of ['Settings (schedule)', 'Settings (manual)']) {\n  try {\n    const s = $(n).first();\n    if (s && s.json.force === true) force = true;\n  } catch (e) {}\n}\n\nreturn [{ json: { is_new: force || latest > last, force: force, latest_month: latest, last_published_month: last, rows_in_table: rows.length } }];"
      },
