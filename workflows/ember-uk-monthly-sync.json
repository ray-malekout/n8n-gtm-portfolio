    {
      "parameters": {
        "jsCode": "// Flatten Ember's response (handles both one item with a `data` array, or pre-split items)\nconst raw = $input.all().flatMap(item => item.json.data ?? [item.json]);\n\nconst rows = raw.map(r => ({\n  month: r.date.slice(0, 7),            // \"2026-09-01\" -> \"2026-09\"\n  series: r.series,\n  generation_twh: r.generation_twh,\n  share_pct: r.share_of_generation_pct,\n}));\n\n// Group by series, sort by month, calculate change vs previous month\nconst round = x => Math.round(x * 100) / 100;\nconst bySeries = {};\nfor (const r of rows) (bySeries[r.series] ??= []).push(r);\n\nconst out = [];\nfor (const [series, list] of Object.entries(bySeries)) {\n  list.sort((a, b) => a.month.localeCompare(b.month));\n  list.forEach((r, i) => {\n    const prev = list[i - 1];\n    out.push({\n      json: {\n        key: `${r.month}|${series}`,\n        ...r,\n        prev_month: prev ? prev.month : null,\n        share_change_pts: prev ? round(r.share_pct - prev.share_pct) : null,\n        twh_change: prev ? round(r.generation_twh - prev.generation_twh) : null,\n      },\n    });\n  });\n}\nreturn out;"
      },
