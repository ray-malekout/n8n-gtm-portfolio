      "name": "Get row(s)"
    },
    {
      "parameters": {
        "jsCode": "const requested = $('When Executed by Another Workflow').first().json.month;\nconst rows = $input.all().map(i => i.json);\n\nconst months = [...new Set(rows.map(r => r.month))].sort();\nconst month = (!requested || requested === 'latest') ? months.at(-1) : requested;\n\nconst result = rows\n  .filter(r => r.month === month)\n  .map(({ key, ...r }) => r)            // drop the internal key\n  .sort((a, b) => (b.share_change_pts ?? 0) - (a.share_change_pts ?? 0));\n\nif (result.length === 0) {\n  return [{ json: { error: `No data for ${month}. Available: ${months[0]} to ${months.at(-1)}` } }];\n}\nreturn [{ json: { month, rows: result } }];"
      },
      "type": "n8n-nodes-base.code",
